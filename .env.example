# Dedicapag NextGen Environment Configuration (Optional Cloud Tier)
# NOTE: Dedicapag NextGen is 100% functional WITHOUT any backend or API keys!
# These environment variables are only required if you choose to enable the optional Cloud Sync or Voluntary Tips.

# Optional: Supabase Database (for cloud shortlinks and gallery)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Stripe (for voluntary "Buy Me a Coffee / Paga lo que sientas" contributions)
VITE_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public Domain & App Configuration
VITE_APP_URL=http://localhost:4173
VITE_APP_NAME="Dedicapag NextGen"
